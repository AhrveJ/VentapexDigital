# Copy this file to .env and fill it in. .env is never committed to git.

# ---------- Public: built into the website, visible to anyone ----------

# reCAPTCHA v2 "I'm not a robot" SITE key (https://www.google.com/recaptcha/admin)
VITE_RECAPTCHA_SITE_KEY=

# Where the contact form posts. Leave as is.
VITE_FORM_ENDPOINT=/api/contact

# ---------- Private: server only. Never add VITE_ to these names. ----------

# reCAPTCHA v2 SECRET key (same Google page as the site key)
RECAPTCHA_SECRET=

# Bluehost mailbox the form sends from (Bluehost: Email > Create, e.g. website@yourdomain.com)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=website@yourdomain.com
SMTP_PASS=

# Where inquiries are delivered
MAIL_TO=hello@yourdomain.com

# Business name shown in the inquiry email (optional)
SITE_NAME=AZN Accounting LLC

# Submissions allowed per visitor IP per hour
MAX_PER_HOUR=5

# Sites allowed to call the form script from a browser, comma-separated
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://localhost:5173

# ---------- Local development only (npm run dev). Not used on Bluehost. ----------

# Port for the Python contact API on your computer. Change it if 5001 is already in use.
DEV_API_PORT=5001
